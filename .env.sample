# Integration with alexandria
# No trailing slash
ALEXANDRIA_BASE_URL=
ALEXANDRIA_SERVICE_API_TOKEN=
# A kst_ token is robles's API v2 token and publishes through /api/v2 (WEB-8205, WEB-8208); anything else is the shared token and uses v1

# Integration with betamax
# No trailing slash
BETAMAX_BASE_URL=
BETAMAX_SERVICE_API_TOKEN=

# Environment
ENV=production

# Uploading images to S3 bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=

# CDN for image uploads
IMAGES_CDN_HOST=

# Build notifications as part of CI
SLACK_WEBHOOK_URL=

# For management of repo secrets
GITHUB_TOKEN=
REPO_ALEXANDRIA_SERVICE_API_TOKEN_PRODUCTION=
REPO_ALEXANDRIA_SERVICE_API_TOKEN_STAGING=
REPO_AWS_ACCESS_KEY_ID_PRODUCTION=
REPO_AWS_ACCESS_KEY_ID_STAGING=
REPO_AWS_SECRET_ACCESS_KEY_PRODUCTION=
REPO_AWS_SECRET_ACCESS_KEY_STAGING=
REPO_SLACK_BOT_TOKEN=
REPO_SLACK_WEBHOOK_URL=
